{
  "cases": [
    {
      "name": "allocate and resolve",
      "suite": "examples",
      "config": {},
      "operations": [
        {
          "op": "shorten",
          "args": [
            "https://example.test/a"
          ],
          "expect": "1"
        },
        {
          "op": "resolve",
          "args": [
            "1"
          ],
          "expect": "https://example.test/a"
        },
        {
          "op": "resolve",
          "args": [
            "missing"
          ],
          "expect": null
        }
      ]
    },
    {
      "name": "duplicates do not consume IDs",
      "suite": "assessment",
      "config": {},
      "operations": [
        {
          "op": "shorten",
          "args": [
            "https://example.test/a"
          ],
          "expect": "1"
        },
        {
          "op": "shorten",
          "args": [
            "https://example.test/a"
          ],
          "expect": "1"
        },
        {
          "op": "shorten",
          "args": [
            "https://example.test/b"
          ],
          "expect": "2"
        },
        {
          "op": "resolve",
          "args": [
            "2"
          ],
          "expect": "https://example.test/b"
        }
      ]
    },
    {
      "name": "unknown reads do not allocate",
      "suite": "assessment",
      "config": {},
      "operations": [
        {
          "op": "resolve",
          "args": [
            "1"
          ],
          "expect": null
        },
        {
          "op": "resolve",
          "args": [
            ""
          ],
          "expect": null
        },
        {
          "op": "shorten",
          "args": [
            "u"
          ],
          "expect": "1"
        },
        {
          "op": "resolve",
          "args": [
            "01"
          ],
          "expect": null
        },
        {
          "op": "resolve",
          "args": [
            "1"
          ],
          "expect": "u"
        }
      ]
    },
    {
      "name": "opaque URL identity",
      "suite": "assessment",
      "config": {},
      "operations": [
        {
