    {
      "name": "reserve and acknowledge",
      "suite": "examples",
      "config": {
        "visibility_ms": 100,
        "max_attempts": 3
      },
      "operations": [
        {
          "op": "enqueue",
          "args": [
            "email"
          ],
          "expect": "job-1"
        },
        {
          "op": "reserve",
          "args": [],
          "expect": {
            "job_id": "job-1",
            "payload": "email",
            "attempt": 1,
            "receipt": "lease-1"
          }
        },
        {
          "op": "ack",
          "args": [
            "lease-1"
          ],
          "expect": true
        },
        {
          "op": "reserve",
          "args": [],
          "expect": null
        },
        {
          "op": "dead_letters",
          "args": [],
          "expect": []
        }
      ]
    },
