{
  "cases": [
    {
      "name": "limit and reset",
      "suite": "examples",
      "config": {
        "limit": 2,
        "window_ms": 100
      },
      "operations": [
        {
          "op": "allow",
          "args": [
            "a"
          ],
          "expect": true
        },
        {
          "op": "allow",
          "args": [
            "a"
          ],
          "expect": true
        },
        {
          "op": "allow",
          "args": [
            "a"
          ],
          "expect": false
        },
        {
          "op": "advance",
          "args": [
            100
          ],
          "expect": null
        },
        {
          "op": "allow",
          "args": [
            "a"
          ],
          "expect": true
        }
      ]
    },
