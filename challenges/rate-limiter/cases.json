    {
      "name": "client isolation",
      "suite": "assessment",
      "config": {
        "limit": 1,
        "window_ms": 10
      },
      "operations": [
        {
          "op": "allow",
          "args": [
            "a"
          ],
          "expect": true
        },
        {
          "op": "allow",
          "args": [
            "b"
